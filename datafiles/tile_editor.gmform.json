{
  "format":"gmforms",
  "version":1,
  "root":{
    "class":"Form",
    "name":"frmTiles",
    "caption":"GMForms - tile editor sample",
    "height":700,
    "width":1024,
    "children":[
      {
        "class":"MenuBar",
        "name":"mbMain",
        "menus":[
          {
            "caption":"File",
            "items":[
              {
                "caption":"New",
                "onClick":"mnuNew_Click",
                "shortcut":"Ctrl+N"
              },
              {
                "caption":"Open",
                "onClick":"mnuOpen_Click",
                "shortcut":"Ctrl+O"
              },
              {
                "caption":"Save",
                "onClick":"mnuSave_Click",
                "shortcut":"Ctrl+S"
              },
              {
                "caption":"-",
                "separator":true
              },
              {
                "caption":"Other demos",
                "items":[
                  {
                    "caption":"Form designer",
                    "onClick":"mnuDesigner_Click"
                  },
                  {
                    "caption":"M5 controls gallery",
                    "onClick":"mnuGallery_Click"
                  },
                  {
                    "caption":"M1 layout demo",
                    "onClick":"mnuM1Demo_Click"
                  }
                ]
              },
              {
                "caption":"-",
                "separator":true
              },
              {
                "caption":"Exit",
                "onClick":"mnuExit_Click"
              }
            ]
          },
          {
            "caption":"Edit",
            "items":[
              {
                "caption":"Undo",
                "onClick":"mnuUndo_Click",
                "shortcut":"Ctrl+Z"
              },
              {
                "caption":"Redo",
                "alt_shortcut":"Ctrl+Shift+Z",
                "onClick":"mnuRedo_Click",
                "shortcut":"Ctrl+Y"
              },
              {
                "caption":"-",
                "separator":true
              },
              {
                "caption":"Clear map",
                "onClick":"mnuClear_Click",
                "shortcut":"Ctrl+Delete"
              }
            ]
          },
          {
            "caption":"Tools",
            "items":[
              {
                "caption":"Paint",
                "checked":true,
                "onClick":"mnuPaint_Click",
                "shortcut":"Ctrl+1"
              },
              {
                "caption":"Select",
                "onClick":"mnuSelect_Click",
                "shortcut":"Ctrl+2"
              }
            ]
          },
          {
            "caption":"View",
            "items":[
              {
                "caption":"Zoom in",
                "onClick":"mnuZoomIn_Click",
                "shortcut":"Ctrl+Up"
              },
              {
                "caption":"Zoom out",
                "onClick":"mnuZoomOut_Click",
                "shortcut":"Ctrl+Down"
              },
              {
                "caption":"Reset view",
                "onClick":"mnuResetView_Click",
                "shortcut":"Ctrl+0"
              },
              {
                "caption":"-",
                "separator":true
              },
              {
                "caption":"Show grid",
                "checked":true,
                "onClick":"mnuShowGrid_Click"
              },
              {
                "caption":"Map properties",
                "onClick":"mnuMapProps_Click",
                "shortcut":"F4"
              }
            ]
          }
        ]
      },
      {
        "class":"Toolbar",
        "name":"tbMain",
        "children":[
          {
            "class":"Button",
            "name":"btnNew",
            "caption":"New",
            "height":26,
            "onClick":"btnNew_Click",
            "tab_stop":true,
            "width":50
          },
          {
            "class":"Button",
            "name":"btnOpen",
            "caption":"Open",
            "height":26,
            "onClick":"btnOpen_Click",
            "tab_stop":true,
            "width":56
          },
          {
            "class":"Button",
            "name":"btnSave",
            "caption":"Save",
            "height":26,
            "onClick":"btnSave_Click",
            "tab_stop":true,
            "width":56
          },
          {
            "class":"ToolSeparator",
            "name":"ToolSeparator1"
          },
          {
            "class":"Button",
            "name":"btnUndo",
            "caption":"Undo",
            "height":26,
            "onClick":"btnUndo_Click",
            "tab_stop":true,
            "width":56
          },
          {
            "class":"Button",
            "name":"btnRedo",
            "caption":"Redo",
            "height":26,
            "onClick":"btnRedo_Click",
            "tab_stop":true,
            "width":56
          },
          {
            "class":"ToolSeparator",
            "name":"ToolSeparator2"
          },
          {
            "class":"Button",
            "name":"btnPaint",
            "caption":"Paint",
            "height":26,
            "onClick":"btnPaint_Click",
            "tab_stop":true,
            "width":62
          },
          {
            "class":"Button",
            "name":"btnSelect",
            "caption":"Select",
            "height":26,
            "onClick":"btnSelect_Click",
            "tab_stop":true,
            "width":72
          },
          {
            "class":"ToolSeparator",
            "name":"ToolSeparator3"
          },
          {
            "class":"Button",
            "name":"btnClear",
            "caption":"Clear",
            "height":26,
            "onClick":"btnClear_Click",
            "tab_stop":true,
            "width":62
          },
          {
            "class":"Button",
            "name":"btnMapProps",
            "caption":"Map props",
            "height":26,
            "onClick":"btnMapProps_Click",
            "tab_stop":true,
            "width":100
          }
        ]
      },
      {
        "class":"Panel",
        "name":"pnlStatus",
        "align":"bottom",
        "height":26,
        "children":[
          {
            "class":"Label",
            "name":"lblStatus",
            "caption":"",
            "anchors":[
              "left",
              "top",
              "right"
            ],
            "left":4,
            "top":2,
            "width":1016
          }
        ]
      },
      {
        "class":"Panel",
        "name":"pnlPalette",
        "caption":"Tiles",
        "align":"left",
        "width":150
      },
      {
        "class":"Splitter",
        "name":"splPalette",
        "align":"left",
        "min_size":90
      },
      {
        "class":"Panel",
        "name":"pnlInspector",
        "align":"right",
        "width":300,
        "children":[
          {
            "class":"Label",
            "name":"lblInspector",
            "caption":"",
            "align":"top",
            "height":24
          },
          {
            "class":"PropertyGrid",
            "name":"gridProps",
            "align":"client",
            "margin":{
              "b":4,
              "l":4,
              "r":4,
              "t":0
            },
            "name_width":120,
            "onChange":"gridProps_Change"
          }
        ]
      },
      {
        "class":"Splitter",
        "name":"splInspector",
        "align":"right",
        "min_size":160
      },
      {
        "class":"Viewport",
        "name":"vpMap",
        "align":"client",
        "onDraw":"vpMap_Draw",
        "onMouseDown":"vpMap_MouseDown",
        "onMouseMove":"vpMap_MouseMove",
        "onMouseUp":"vpMap_MouseUp",
        "onWheel":"vpMap_Wheel"
      }
    ]
  }
}