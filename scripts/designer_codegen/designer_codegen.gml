/// GMForms designer — event stub generation (plan section 14, decision D10).
///
/// "Generate handlers" writes a .gml script holding one constructor with an empty method for every
/// handler name the form uses (control events and menu items). Regenerating keeps whatever is in
/// the existing file and only appends methods whose names aren't there yet.

/// @func gmforms_design_handlers_name(form)
/// @desc Constructor name for a form's handlers, e.g. "frmMain_Handlers".
function gmforms_design_handlers_name(_form) {
    return ((_form.name != "") ? _form.name : "Form") + "_Handlers";
}

/// @func gmforms_design_event_params(event)
/// @desc Parameter list for a handler of this event (first argument is always the sender).
function gmforms_design_event_params(_event) {
    switch (_event) {
        case "onMouseDown":
        case "onMouseUp":    return "_sender, _x, _y, _button";
        case "onMouseMove":  return "_sender, _x, _y";
        case "onMouseWheel":
        case "onWheel":      return "_sender, _delta";
        case "onKeyDown":
        case "onKeyUp":      return "_sender, _key";
        case "onChange":     return "_sender, _value";
        case "onDraw":       return "_sender, _cam";
        case "onActivate":   return "_sender, _item";
        case "onExpand":     return "_sender, _node, _expanded";
        case "onMenuClick":  return "_sender, _item";
    }
    return "_sender";
}

/// @func gmforms_design_collect_handlers(form)
/// @desc Every handler name the form uses, in tree order, without duplicates:
///       [{ name, event, control }] — menu items report event "onMenuClick".
function gmforms_design_collect_handlers(_form) {
    var _ctx = { out: [], seen: {} };
    _form.walk(method(_ctx, function(_c) {
        // report events in published order (onClick before onChange...), not alphabetically
        var _pub = _c.published;
        for (var _i = 0; _i < array_length(_pub); _i++) {
            var _p = _pub[_i];
            if (_p.type == "event") {
                var _h = _c._ev_names[$ __gmforms_event_field(_p.name)];
                if (_h != undefined && _h != "" && !struct_exists(seen, _h)) {
                    seen[$ _h] = true;
                    array_push(out, { name: _h, event: _p.name, control: _c.name });
                }
            } else if (_p.type == "menus") {
                __gmforms_design_collect_menu(_c[$ _p.name], _c.name, self);
            }
        }
    }));
    return _ctx.out;
}

function __gmforms_design_collect_menu(_items, _owner, _ctx) {
    if (!is_array(_items)) return;
    for (var _i = 0; _i < array_length(_items); _i++) {
        var _it = _items[_i];
        var _h = _it[$ "on_click_name"] ?? "";
        if (_h != "" && !struct_exists(_ctx.seen, _h)) {
            _ctx.seen[$ _h] = true;
            array_push(_ctx.out, { name: _h, event: "onMenuClick", control: _owner + " > " + string(_it[$ "caption"] ?? "") });
        }
        __gmforms_design_collect_menu(_it[$ "items"], _owner, _ctx);
    }
}

/// @func gmforms_design_existing_handlers(source)
/// @desc Names assigned as `name = function` in existing GML source (one per line).
function gmforms_design_existing_handlers(_src) {
    var _out = {};
    var _lines = string_split(string_replace_all(_src, "\r", ""), "\n");
    for (var _i = 0; _i < array_length(_lines); _i++) {
        var _l = string_trim(_lines[_i]);
        var _eq = string_pos("=", _l);
        if (_eq <= 1) continue;
        var _name = string_trim(string_copy(_l, 1, _eq - 1));
        var _rest = string_trim(string_delete(_l, 1, _eq));
        if (string_pos("function", _rest) != 1) continue;
        if (string_length(string_lettersdigits(string_replace_all(_name, "_", ""))) != string_length(string_replace_all(_name, "_", ""))) continue;
        _out[$ _name] = true;
    }
    return _out;
}

/// @func gmforms_design_handlers_source(form, [existing_source])
/// @desc Handler script source for a form. With existing_source, returns it with only the missing
///       methods inserted before its last "}" (unchanged if nothing is missing).
/// @returns {String}
function gmforms_design_handlers_source(_form, _existing = "") {
    var _all = gmforms_design_collect_handlers(_form);
    var _have = gmforms_design_existing_handlers(_existing);
    var _methods = "";
    for (var _i = 0; _i < array_length(_all); _i++) {
        var _h = _all[_i];
        if (struct_exists(_have, _h.name)) continue;
        _methods += "    /// " + _h.control + " — " + _h.event + "\n";
        _methods += "    " + _h.name + " = function(" + gmforms_design_event_params(_h.event) + ") {\n";
        _methods += "    };\n\n";
    }
    if (string_trim(_existing) == "") {
        var _cname = gmforms_design_handlers_name(_form);
        return "/// Event handlers for form '" + _form.name + "'. Generated by the GMForms designer:\n"
            + "/// add this script to your project, then load the form with\n"
            + "///     gmforms_load_form(\"" + _form.name + ".gmform.json\", new " + _cname + "());\n"
            + "/// Regenerating keeps your code and only appends handlers that are missing.\n\n"
            + "function " + _cname + "() constructor {\n"
            + _methods
            + "}\n";
    }
    if (_methods == "") return _existing;
    var _pos = string_last_pos("}", _existing);
    if (_pos <= 0) return _existing + "\n" + _methods;
    return string_copy(_existing, 1, _pos - 1) + _methods + string_delete(_existing, 1, _pos - 1);
}

/// @func gmforms_design_ident(text)
/// @desc "Open recent..." -> "OpenRecent": letters/digits of each word, capitalised, for handler names.
function gmforms_design_ident(_text) {
    var _out = "";
    var _up = true;
    for (var _i = 1; _i <= string_length(_text); _i++) {
        var _ch = string_char_at(_text, _i);
        if (string_lettersdigits(_ch) == "") { _up = true; continue; }
        _out += _up ? string_upper(_ch) : _ch;
        _up = false;
    }
    return _out;
}
